+#!/usr/bin/env node
+// Back up, verify and restore run history from the command line (issue #183).
+// Stop the server first: a backup drains only this process's queued writes.
+import { createBackup, restoreBackup, verifyBackup } from './history-backup.js'
+
+const usage = `usage:
+  node src/storage/history-backup-cli.js backup <history.json> <backup.json>
+  node src/storage/history-backup-cli.js verify <backup.json>
+  node src/storage/history-backup-cli.js restore <backup.json> <history.json> [--replace]`
+
+const [command, first, second, ...rest] = process.argv.slice(2)
+
+function report(label, summary) {
+  console.log(`${label}: ${summary.runCount} runs, ${summary.proofCount} payment proofs, schema v${summary.schemaVersion}`)
+}
+
+try {
+  if (command === 'backup' && first && second) {
+    report('backed up', await createBackup({ filePath: first, flush: async () => {} }, second))
+  } else if (command === 'verify' && first) {
+    report('verified', await verifyBackup(first))
+  } else if (command === 'restore' && first && second) {
+    const summary = await restoreBackup(first, second, { replace: rest.includes('--replace') })
+    report('restored', summary)
+    if (summary.preserved) console.log(`previous history kept at ${summary.preserved}`)
+  } else {
+    console.error(usage)
+    process.exit(2)
+  }
+} catch (err) {
+  console.error(err.message)
+  process.exit(1)
+}
diff --git a/src/storage/history-backup.js b/src/storage/history-backup.js
new file mode 100644
index 0000000..75fc0e7
--- /dev/null
+++ b/src/storage/history-backup.js
@@ -0,0 +1,119 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import crypto from 'node:crypto'
+
+// Backup and restore for file-based run history (issue #183).
+//
+// A backup is one JSON file holding the history file's exact bytes plus what is
+// needed to trust them later: the schema version, run and payment-proof counts,
+// and a SHA-256 of the bytes. Restore checks all of it before touching the
+// target, and never replaces an existing history unless asked to — and then it
+// keeps the original beside it.
+
+export const BACKUP_FORMAT = 'stellarmind.run-history-backup'
+export const BACKUP_FORMAT_VERSION = 1
+const SUPPORTED_SCHEMA_VERSION = 1
+
+export class BackupError extends Error {
+  constructor(message) {
+    super(`run history backup: ${message}`)
+    this.name = 'BackupError'
+  }
+}
+
+function sha256(text) {
+  return crypto.createHash('sha256').update(text, 'utf8').digest('hex')
+}
+
+function summarize(history) {
+  const runs = Array.isArray(history.runs) ? history.runs : []
+  return {
+    schemaVersion: history.version,
+    runCount: runs.length,
+    proofCount: runs.reduce((n, run) => n + (Array.isArray(run.txProofs) ? run.txProofs.length : 0), 0),
+    runIds: runs.map((run) => run.id),
+  }
+}
+
+async function writeAtomically(filePath, text) {
+  const tempPath = `${filePath}.${crypto.randomBytes(4).toString('hex')}.tmp`
+  try {
+    await fs.writeFile(tempPath, text, 'utf8')
+    await fs.rename(tempPath, filePath)
+  } catch (err) {
+    await fs.unlink(tempPath).catch(() => {})
+    throw err
+  }
+}
+
+/**
+ * Snapshot a FileRunHistoryStore (or anything with `filePath` and `flush()`).
+ * Queued writes are drained first, so the snapshot is a state the store reached.
+ */
+export async function createBackup(store, backupPath) {
+  await store.flush()
+  const raw = await fs.readFile(store.filePath, 'utf8')
+  const summary = summarize(JSON.parse(raw))
+  const backup = {
+    format: BACKUP_FORMAT,
+    formatVersion: BACKUP_FORMAT_VERSION,
+    createdAt: new Date().toISOString(),
+    schemaVersion: summary.schemaVersion,
+    runCount: summary.runCount,
+    proofCount: summary.proofCount,
+    sha256: sha256(raw),
+    history: raw,
+  }
+  await fs.mkdir(path.dirname(backupPath), { recursive: true })
+  await writeAtomically(backupPath, JSON.stringify(backup, null, 2))
+  return summary
+}
+
+/** Check a backup end to end; throws BackupError, or returns its summary and history bytes. */
+export async function verifyBackup(backupPath) {
+  let backup
+  try {
+    backup = JSON.parse(await fs.readFile(backupPath, 'utf8'))
+  } catch (err) {
+    throw new BackupError(`cannot read ${backupPath} (${err.code || err.name})`)
+  }
+  if (backup.format !== BACKUP_FORMAT || backup.formatVersion !== BACKUP_FORMAT_VERSION) {
+    throw new BackupError('not a run history backup, or an unsupported backup format')
+  }
+  if (typeof backup.history !== 'string') {
+    throw new BackupError('backup has no history')
+  }
+  const summary = summarize(JSON.parse(backup.history))
+  if (!Number.isInteger(summary.schemaVersion) || summary.schemaVersion > SUPPORTED_SCHEMA_VERSION) {
+    throw new BackupError(
+      `schema version ${summary.schemaVersion} is not supported (this build reads up to ${SUPPORTED_SCHEMA_VERSION})`
+    )
+  }
+  if (summary.runCount !== backup.runCount || summary.proofCount !== backup.proofCount) {
+    throw new BackupError('run or proof counts do not match the backup metadata')
+  }
+  return { ...summary, history: backup.history }
+}
+
+/**
+ * Restore a verified backup to `targetFile`. An existing file is only replaced
+ * with `{ replace: true }`, and is first copied to `<target>.pre-restore.<time>`.
+ */
+export async function restoreBackup(backupPath, targetFile, { replace = false } = {}) {
+  const { history, ...summary } = await verifyBackup(backupPath)
+  const exists = await fs.access(targetFile).then(
+    () => true,
+    () => false
+  )
+  if (exists && !replace) {
+    throw new BackupError(`${targetFile} already exists; restore with replace to swap it (the original is kept)`)
+  }
+  await fs.mkdir(path.dirname(targetFile), { recursive: true })
+  let preserved = null
+  if (exists) {
+    preserved = `${targetFile}.pre-restore.${new Date().toISOString().replace(/[:.]/g, '-')}`
+    await fs.copyFile(targetFile, preserved)
+  }
+  await writeAtomically(targetFile, history)
+  return { ...summary, preserved }
+}
diff --git a/tests/history-backup.test.js b/tests/history-backup.test.js
new file mode 100644
index 0000000..fd9bd86
--- /dev/null
+++ b/tests/history-backup.test.js
@@ -0,0 +1,131 @@
+import fs from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import { FileRunHistoryStore } from '../src/storage/run-history.js'
+import { createBackup, restoreBackup, verifyBackup } from '../src/storage/history-backup.js'
+
+const proof = (txHash) => ({ method: 'x402', txHash, amount: '0.01', asset: 'USDC', network: 'stellar:testnet' })
+
+const fixture = {
+  version: 1,
+  runs: [
+    {
+      id: 'run_a',
+      task: 'Summarize the market',
+      status: 'completed',
+      createdAt: '2026-01-01T00:00:00.000Z',
+      updatedAt: '2026-01-01T00:01:00.000Z',
+      results: [{ agent: 'research', output: 'A' }],
+      output: [{ agent: 'research', output: 'A' }],
+      txProofs: [proof('tx_1'), proof('tx_2')],
+      events: [],
+    },
+    {
+      id: 'run_b',
+      task: 'Price check',
+      status: 'failed',
+      createdAt: '2026-01-02T00:00:00.000Z',
+      updatedAt: '2026-01-02T00:01:00.000Z',
+      error: 'budget exhausted',
+      txProofs: [proof('tx_3')],
+      events: [],
+    },
+  ],
+  idempotency: [],
+}
+
+async function inTempDir(fn) {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'history-backup-'))
+  try {
+    await fn(dir)
+  } finally {
+    await fs.rm(dir, { recursive: true, force: true })
+  }
+}
+
+async function storeWithFixture(dir) {
+  const file = path.join(dir, 'live', 'run-history.json')
+  await fs.mkdir(path.dirname(file), { recursive: true })
+  await fs.writeFile(file, JSON.stringify(fixture), 'utf8')
+  const store = new FileRunHistoryStore(file, 200)
+  await store.init()
+  return store
+}
+
+async function assertRejects(fn, message) {
+  try {
+    await fn()
+  } catch (err) {
+    if (!err.message.includes(message)) throw new Error(`expected "${message}", got: ${err.message}`)
+    return
+  }
+  throw new Error(`expected a rejection containing "${message}"`)
+}
+
+function sameRuns(a, b) {
+  const pick = (run) => ({ id: run.id, output: run.output, error: run.error, txProofs: run.txProofs })
+  return JSON.stringify(a.map(pick)) === JSON.stringify(b.map(pick))
+}
+
+console.log('Testing run history backup and restore...\n')
+
+await inTempDir(async (dir) => {
+  const store = await storeWithFixture(dir)
+  const backupPath = path.join(dir, 'backups', 'history.backup.json')
+  const made = await createBackup(store, backupPath)
+  if (made.runCount !== 2 || made.proofCount !== 3) throw new Error('backup should count 2 runs and 3 proofs')
+
+  const target = path.join(dir, 'fresh', 'run-history.json')
+  const restored = await restoreBackup(backupPath, target)
+  if (restored.runCount !== 2 || restored.proofCount !== 3) throw new Error('restore should report what it restored')
+
+  const reopened = new FileRunHistoryStore(target, 200)
+  await reopened.init()
+  if (!sameRuns(store.runs, reopened.runs)) throw new Error('restored runs should keep ids, outputs and proofs')
+  console.log('  ✓ backup then restore into a fresh directory keeps ids, outputs and payment proofs')
+})
+
+await inTempDir(async (dir) => {
+  const store = await storeWithFixture(dir)
+  const backupPath = path.join(dir, 'history.backup.json')
+  await createBackup(store, backupPath)
+  const backup = JSON.parse(await fs.readFile(backupPath, 'utf8'))
+  backup.history = backup.history.replace('tx_2', 'tx_X')
+  await fs.writeFile(backupPath, JSON.stringify(backup), 'utf8')
+
+  await assertRejects(() => verifyBackup(backupPath), 'checksum mismatch')
+  const target = path.join(dir, 'fresh', 'run-history.json')
+  await assertRejects(() => restoreBackup(backupPath, target), 'checksum mismatch')
+  const written = await fs.access(target).then(() => true, () => false)
+  if (written) throw new Error('a damaged backup must not create a history file')
+  console.log('  ✓ a damaged backup is rejected before anything is written')
+})
+
+await inTempDir(async (dir) => {
+  const store = await storeWithFixture(dir)
+  const backupPath = path.join(dir, 'history.backup.json')
+  await createBackup(store, backupPath)
+
+  await assertRejects(() => restoreBackup(backupPath, store.filePath), 'already exists')
+  const result = await restoreBackup(backupPath, store.filePath, { replace: true })
+  const kept = await fs.readFile(result.preserved, 'utf8')
+  if (JSON.parse(kept).runs.length !== 2) throw new Error('the replaced history should be kept beside it')
+  console.log('  ✓ restore refuses to replace a history unless asked, and keeps the original when it does')
+})
+
+await inTempDir(async (dir) => {
+  const store = await storeWithFixture(dir)
+  const backupPath = path.join(dir, 'history.backup.json')
+  await createBackup(store, backupPath)
+  const backup = JSON.parse(await fs.readFile(backupPath, 'utf8'))
+  const newer = JSON.stringify({ ...JSON.parse(backup.history), version: 2 })
+  const crypto = await import('node:crypto')
+  backup.history = newer
+  backup.sha256 = crypto.createHash('sha256').update(newer, 'utf8').digest('hex')
+  await fs.writeFile(backupPath, JSON.stringify(backup), 'utf8')
+
+  await assertRejects(() => verifyBackup(backupPath), 'schema version 2 is not supported')
+  console.log('  ✓ a backup from a newer schema is refused')
+})
+
+console.log('\nAll backup tests passed! ✓')
